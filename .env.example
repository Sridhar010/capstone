# ── Anthropic API ──────────────────────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: custom API gateway (e.g. enterprise proxy).
# The Anthropic SDK reads this env var automatically.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# ── LLM Model ──────────────────────────────────────────────────────────────────
# Standard Anthropic model ID:
LLM_MODEL=claude-sonnet-4-6
# If using a managed gateway with fully-qualified IDs, use:
# LLM_MODEL=global.anthropic.claude-sonnet-4-6

LLM_MAX_TOKENS=4096

# ── FastAPI Service ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit ──────────────────────────────────────────────────────────────────
STREAMLIT_API_URL=http://localhost:8000

# ── Logging (must be lowercase for uvicorn) ────────────────────────────────────
LOG_LEVEL=info
